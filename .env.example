# PostgreSQL connection string, e.g. from a local Postgres, Docker, or a free Neon/Supabase instance
DATABASE_URL="postgresql://user:password@localhost:5432/shopnest?schema=public"

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:3000"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="shopnest_token"

# Firebase Admin SDK (for verifying Google sign-in tokens from the client)
# Paste the full JSON contents of your Firebase service account key as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON=
